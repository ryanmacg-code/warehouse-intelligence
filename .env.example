# ── Supabase / PostgreSQL connection ──────────────────────────────────────────
# Copy from your Supabase project → Settings → Database → Connection string
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-service-role-password

# ── Tenant config (local dev / stdio fallback) ─────────────────────────────────
# Used when no X-Tenant-Id header is present (stdio transport or local testing).
# In production, the header overrides this.
ARIA_TENANT_ID=00000000-0000-0000-0000-000000000001

# ── Server ────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically; set here only for local Docker testing.
PORT=8080
LOG_LEVEL=INFO
